FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    git \
    jq \
    python3 \
    python3-pip \
    ripgrep \
    libjpeg62-turbo \
    libpng16-16 \
    libtiff6 \
    libwebp7 \
    libfreetype6 \
    zlib1g \
    libopenjp2-7 \
  && rm -rf /var/lib/apt/lists/*

# Pillow native: trace 019e62ff exec span 11/13 failed on "from PIL import _imaging"
# because the system-pip Pillow wheel was stripped. Force-reinstall from PyPI so
# the manylinux wheel (with C extension) lands. Pinned to 10.4.0 — last 10.x
# before 11.0.0 broke compat. Manylinux cp3.11 wheels available.
RUN python3 -m pip install --no-cache-dir --break-system-packages \
    --force-reinstall \
    Pillow==10.4.0

# Sandbox runtime smoke test — exercises native libs that have failed before.
# Image build is gated on this passing via the new sandbox job in image.yaml.
COPY scripts/sandbox-smoke.py /usr/local/bin/sandbox-smoke.py

RUN useradd --create-home --shell /bin/bash sandbox
USER sandbox
WORKDIR /home/sandbox

CMD ["sleep", "infinity"]
